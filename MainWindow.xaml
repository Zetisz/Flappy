<Window x:Class="Flappy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Flappy"
        mc:Ignorable="d"
        Title="Flappy" Height="800" Width="600">
    <Grid x:Name="GridMain">
        <Label Content="Flappy" FontSize="60" HorizontalAlignment="Center"/>
        <Button x:Name="BtnStart" FontSize="60" HorizontalAlignment="Center" Height="100" Width="200" Click="BtnStart_Click">Start</Button>
    </Grid>
</Window>
